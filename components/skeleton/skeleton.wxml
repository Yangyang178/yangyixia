<view class="skeleton {{pulsing ? 'skeleton-pulse' : ''}}" wx:if="{{loading}}">
  <block wx:if="{{type === 'card'}}">
    <view class="sk-card"></view>
  </block>
  <block wx:elif="{{type === 'text'}}">
    <view class="sk-text"></view>
  </block>
  <block wx:elif="{{type === 'avatar'}}">
    <view class="sk-avatar"></view>
  </block>
  <block wx:elif="{{type === 'detail'}}">
    <view class="sk-detail">
      <view class="sk-detail-top">
        <view class="sk-avatar"></view>
        <view class="sk-lines">
          <view class="sk-text sk-text-long"></view>
          <view class="sk-text sk-text-short"></view>
        </view>
      </view>
      <view class="sk-card"></view>
    </view>
  </block>
</view>
