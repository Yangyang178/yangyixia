.skeleton {
  transition: opacity 0.4s ease;
  opacity: 1;
}

.skeleton-pulse {
  opacity: 0.4;
}

.sk-card {
  height: 200rpx;
  border-radius: 20rpx;
  background: var(--bg-grey);
}

.sk-text {
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--bg-grey);
}

.sk-text-long {
  width: 80%;
}

.sk-text-short {
  width: 50%;
  margin-top: 16rpx;
}

.sk-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg-grey);
  flex-shrink: 0;
}

.sk-detail {
  display: flex;
  flex-direction: column;
  padding: 28rpx;
}

.sk-detail-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.sk-detail-top .sk-avatar {
  margin-right: 24rpx;
}

.sk-lines {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.sk-detail .sk-card {
  height: 300rpx;
}
