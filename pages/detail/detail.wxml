<navigation-bar title="{{ingredient.name}}" back="{{true}}" color="#2D3436" background="#F7F5F2">
  <view slot="right" class="nav-fav" bindtap="toggleFav">
    <text>{{isFav ? '❤️' : '🤍'}}</text>
  </view>
</navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="detail-page" wx:if="{{ingredient}}">
    <view class="constitution-tip" wx:if="{{constitutionTip}}">
      <text class="tip-icon">{{constitutionTip.icon}}</text>
      <text class="tip-text">{{constitutionTip.text}}</text>
    </view>

    <view class="hero-card card">
      <view class="hero-image emoji-card" style="background: {{ingredient.color}}"><text class="emoji-text">{{ingredient.emoji}}</text></view>
      <view class="hero-info">
        <view class="hero-name-row">
          <text class="hero-name">{{ingredient.name}}</text>
          <text class="hero-nature">{{ingredient.nature}}</text>
        </view>
        <text class="hero-aliases">别名：{{ingredient.aliases.join('、')}}</text>
        <text class="hero-summary">{{ingredient.summary}}</text>
        <view class="hero-effects">
          <text class="tag tag-primary" wx:for="{{ingredient.effects}}" wx:key="index">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="info-card card">
      <view class="info-row">
        <text class="info-label">性味归经</text>
        <text class="info-value">性{{ingredient.nature}}，入{{ingredient.meridians.join('、')}}经</text>
      </view>
      <view class="divider"></view>
      <view class="info-row">
        <text class="info-label">分类</text>
        <text class="info-value">{{ingredient.category}} · {{ingredient.form}}类</text>
      </view>
      <view class="divider"></view>
      <view class="info-row">
        <text class="info-label">营养素</text>
        <text class="info-value">{{ingredient.nutrients}}</text>
      </view>
    </view>

    <view class="constitution-card card">
      <view class="card-title">体质适配</view>
      <view class="constitution-row">
        <text class="const-label suitable">✅ 适合体质</text>
        <view class="const-tags">
          <text class="tag tag-success" wx:for="{{ingredient.suitableConstitutions}}" wx:key="index">{{item}}</text>
        </view>
      </view>
      <view class="constitution-row">
        <text class="const-label caution">⚠️ 慎用体质</text>
        <view class="const-tags">
          <text class="tag tag-danger" wx:for="{{ingredient.cautionConstitutions}}" wx:key="index">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="warning-card card" wx:if="{{ingredient.contraindication}}">
      <view class="card-title">⚠️ 禁忌说明</view>
      <text class="warning-text">{{ingredient.contraindication}}</text>
    </view>

    <view class="pairing-card card" wx:if="{{ingredient.pairings.length > 0}}">
      <view class="card-title">搭配建议</view>
      <view class="pairing-item" wx:for="{{ingredient.pairings}}" wx:key="index">
        <view class="pairing-name">{{item.name}}</view>
        <view class="pairing-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="action-btns">
      <view class="btn-primary" bindtap="goMatch">加入搭配自检</view>
    </view>

    <view class="disclaimer">
      本小程序仅供养生知识参考，不构成医疗建议
    </view>
  </view>
</scroll-view>
