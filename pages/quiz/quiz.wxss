.quiz-page {
  padding: 20rpx 28rpx 40rpx;
}

.quiz-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 60rpx 40rpx;
}

.quiz-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.quiz-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.quiz-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}

.quiz-notice {
  background: var(--warning-light);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
  width: 100%;
}

.notice-text {
  font-size: 24rpx;
  color: var(--warning);
}

.start-btn {
  width: 100%;
  max-width: 500rpx;
}

.quiz-body {
  padding: 0 0 20rpx;
}

.progress-bar {
  height: 8rpx;
  background: var(--bg-grey);
  border-radius: 4rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-bottom: 24rpx;
  display: block;
}

.question-card {
  margin-bottom: 28rpx;
}

.question-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 28rpx;
  display: block;
}

.options-list {
  display: flex;
  flex-direction: column;
}

.option-item {
  display: flex;
  align-items: center;
  background: var(--bg-grey);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.option-item.selected {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.option-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border);
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-item.selected .option-radio {
  border-color: var(--primary);
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--primary);
}

.option-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.quiz-actions {
  display: flex;
}

.prev-btn {
  flex: 1;
  margin-right: 20rpx;
}

.next-btn {
  flex: 2;
}

.existing-result {
  margin-top: 20rpx;
}

.existing-info {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.existing-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.existing-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
}

.existing-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: block;
}

.retake-btn {
  width: 100%;
}
