.calendar-page {
  padding: 20rpx 28rpx 40rpx;
}

.current-term-card {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(91, 140, 90, 0.25);
}

.current-term-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.current-term-badge {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.current-term-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.current-term-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.current-term-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 20rpx;
}

.current-term-advice-row {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.current-term-advice-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 4rpx;
}

.current-term-advice {
  font-size: 26rpx;
  color: #FFFFFF;
  display: block;
  line-height: 1.5;
}

.current-term-ingredients {
  margin-top: 4rpx;
}

.current-term-ingredients-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 12rpx;
}

.ingredient-row {
  display: flex;
  flex-wrap: wrap;
}

.ingredient-mini-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  margin-bottom: 8rpx;
}

.ingredient-mini-emoji {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  margin-bottom: 6rpx;
}

.emoji-text-xs {
  font-size: 32rpx;
  line-height: 1;
}

.ingredient-mini-name {
  font-size: 20rpx;
  color: #FFFFFF;
  text-align: center;
}

.timeline-section {
  margin-bottom: 20rpx;
}

.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  flex-direction: row;
}

.timeline-dot-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--border);
  flex-shrink: 0;
  margin-top: 32rpx;
}

.dot-active {
  background: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(91, 140, 90, 0.2);
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  background: var(--border);
  margin: 4rpx 0;
}

.timeline-content {
  flex: 1;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.timeline-item.is-current .timeline-content {
  border-left: 6rpx solid var(--primary);
  background: var(--primary-bg);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.timeline-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.timeline-item.is-current .timeline-name {
  color: var(--primary);
}

.timeline-date {
  font-size: 24rpx;
  color: var(--text-hint);
}

.timeline-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.timeline-advice {
  font-size: 24rpx;
  color: var(--primary-dark);
  display: block;
  margin-bottom: 12rpx;
}

.timeline-ingredients {
  display: flex;
  flex-wrap: wrap;
}

.timeline-ingredients .ingredient-mini-card {
  margin-right: 16rpx;
}

.timeline-ingredients .ingredient-mini-name {
  color: var(--text-secondary);
}