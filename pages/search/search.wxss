.search-page {
  padding: 20rpx 28rpx 40rpx;
}

.search-box {
  margin-bottom: 24rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 2rpx 12rpx var(--shadow);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-hint);
  padding: 8rpx;
}

.filter-tabs {
  display: flex;
  margin-bottom: 24rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx var(--shadow);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: 12rpx;
}

.filter-tab.active {
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 500;
}

.filter-content {
  margin-bottom: 24rpx;
}

.filter-list {
  display: flex;
  flex-wrap: wrap;
}

.filter-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 16rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: var(--text-primary);
  box-shadow: 0 2rpx 8rpx var(--shadow);
}

.filter-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.nature-badge {
  font-weight: 600;
  margin-right: 8rpx;
}

.filter-active {
  margin-bottom: 24rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  background: var(--primary-bg);
  color: var(--primary);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

.filter-remove {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--primary);
}

.result-list {
  margin-bottom: 20rpx;
}

.result-item {
  display: flex;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx var(--shadow);
}

.result-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.result-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.result-nature {
  font-size: 22rpx;
  color: var(--accent-dark);
  background: var(--accent-light);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.result-summary {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin: 8rpx 0;
}

.result-effects {
  display: flex;
  flex-wrap: wrap;
}
