<navigation-bar title="我的" back="{{false}}" color="#2D3436" background="#F7F5F2"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="profile-page">
    <view class="profile-header card">
      <view class="constitution-info" wx:if="{{constitution}}" bindtap="goQuiz">
        <text class="constitution-icon">{{constitution.icon}}</text>
        <view class="constitution-detail">
          <text class="constitution-name">{{constitution.name}}</text>
          <text class="constitution-desc">{{constitution.description}}</text>
        </view>
        <text class="constitution-arrow">重新测试 ›</text>
      </view>
      <view class="no-constitution" wx:if="{{!constitution}}" bindtap="goQuiz">
        <text class="no-icon">📋</text>
        <view class="no-detail">
          <text class="no-title">还未测试体质</text>
          <text class="no-desc">8道题测出你的中医体质</text>
        </view>
        <text class="no-arrow">去测试 ›</text>
      </view>
    </view>

    <view class="menu-section">
      <view class="section-title">我的收藏</view>
      <view class="fav-list" wx:if="{{favoriteItems.length > 0}}">
        <view class="fav-item" wx:for="{{favoriteItems}}" wx:key="id"
              bindtap="goDetail" data-id="{{item.id}}">
          <view class="fav-image emoji-card" style="background: {{item.color}}"><text class="emoji-text-sm">{{item.emoji}}</text></view>
          <view class="fav-info">
            <text class="fav-name">{{item.name}}</text>
            <text class="fav-effect">{{item.effectCategory}}</text>
          </view>
          <text class="fav-arrow">›</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{favoriteItems.length === 0}}">
        <text class="empty-icon">💝</text>
        <text class="empty-text">还没有收藏食材，去首页看看吧</text>
      </view>
    </view>

    <view class="menu-section">
      <view class="section-title">浏览历史</view>
      <view class="history-grid" wx:if="{{historyItems.length > 0}}">
        <view class="history-item" wx:for="{{historyItems}}" wx:key="id"
              bindtap="goDetail" data-id="{{item.id}}">
          <view class="history-image emoji-card" style="background: {{item.color}}"><text class="emoji-text-sm">{{item.emoji}}</text></view>
          <text class="history-name">{{item.name}}</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{historyItems.length === 0}}">
        <text class="empty-icon">📖</text>
        <text class="empty-text">还没有浏览记录</text>
      </view>
    </view>

    <view class="menu-section">
      <view class="menu-item" bindtap="goAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于养生查</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goDisclaimer">
        <text class="menu-icon">📝</text>
        <text class="menu-text">免责声明</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="disclaimer">
      本小程序仅供养生知识参考，不构成医疗建议。如有健康问题请咨询专业医师。
    </view>
  </view>
</scroll-view>
