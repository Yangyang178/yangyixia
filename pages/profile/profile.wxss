.profile-page {
  padding: 20rpx 28rpx 40rpx;
}

.profile-header {
  margin-bottom: 28rpx;
}

.constitution-info {
  display: flex;
  align-items: center;
}

.constitution-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.constitution-detail {
  flex: 1;
}

.constitution-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  display: block;
}

.constitution-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}

.constitution-arrow {
  font-size: 24rpx;
  color: var(--primary);
  white-space: nowrap;
}

.no-constitution {
  display: flex;
  align-items: center;
}

.no-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.no-detail {
  flex: 1;
}

.no-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.no-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  display: block;
  margin-top: 4rpx;
}

.no-arrow {
  font-size: 24rpx;
  color: var(--primary);
  white-space: nowrap;
}

.menu-section {
  margin-bottom: 28rpx;
}

.fav-list {
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx var(--shadow);
}

.fav-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.fav-item:last-child {
  border-bottom: none;
}

.fav-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-info {
  flex: 1;
}

.fav-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}

.fav-effect {
  font-size: 22rpx;
  color: var(--text-hint);
  display: block;
  margin-top: 4rpx;
}

.fav-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
}

.history-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.history-item {
  width: calc(20% - 16rpx);
  margin: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.history-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-name {
  font-size: 22rpx;
  color: var(--text-primary);
}

.menu-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  padding: 28rpx;
  margin-bottom: 2rpx;
  box-shadow: 0 2rpx 8rpx var(--shadow);
}

.menu-item:first-child {
  border-radius: 20rpx 20rpx 0 0;
}

.menu-item:last-child {
  border-radius: 0 0 20rpx 20rpx;
  margin-bottom: 0;
}

.menu-item:only-child {
  border-radius: 20rpx;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-hint);
}
