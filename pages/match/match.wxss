.match-page {
  padding: 20rpx 28rpx 40rpx;
}

.intro-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 28rpx;
}

.intro-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.intro-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.intro-desc {
  font-size: 24rpx;
  color: var(--text-hint);
}

.selected-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: var(--danger);
}

.selected-scroll {
  white-space: nowrap;
}

.selected-list {
  display: flex;
  padding-bottom: 8rpx;
}

.selected-item {
  position: relative;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.selected-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  border: 3rpx solid var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.selected-name {
  font-size: 22rpx;
  color: var(--text-primary);
  margin-top: 6rpx;
}

.selected-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  background: var(--danger);
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-section {
  margin-bottom: 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 2rpx 12rpx var(--shadow);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.add-list {
  margin-bottom: 24rpx;
}

.add-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx var(--shadow);
}

.add-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-info {
  flex: 1;
}

.add-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
}

.add-effect {
  font-size: 22rpx;
  color: var(--text-hint);
  display: block;
}

.add-btn {
  font-size: 36rpx;
  color: var(--primary);
  font-weight: 700;
  padding: 8rpx 20rpx;
}

.add-btn.added {
  font-size: 22rpx;
  color: var(--text-hint);
  font-weight: 400;
}

.quick-add {
  margin-bottom: 24rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.quick-item {
  width: calc(20% - 16rpx);
  margin: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.quick-item.selected {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.quick-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-name {
  font-size: 22rpx;
  color: var(--text-primary);
}

.check-btn-wrap {
  margin: 24rpx 0;
}

.check-btn {
  width: 100%;
}

.result-section {
  margin-top: 20rpx;
}

.result-card {
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.success-title {
  color: var(--success);
}

.caution-title {
  color: var(--warning);
}

.danger-title {
  color: var(--danger);
}

.result-item {
  background: var(--bg-grey);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.result-pair {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.result-reason {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.result-source {
  font-size: 20rpx;
  color: var(--text-hint);
}

.no-rule-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.constitution-match {
  margin-bottom: 16rpx;
}

.constitution-match-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
